# Local infrastructure. These values are intentionally local-only defaults.
POSTGRES_USER=uas
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=uas
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
API_PORT=8000
WEB_PORT=3000

# Backend settings use the UAS_ prefix.
UAS_ENVIRONMENT=local
UAS_DATABASE_URL=postgresql+asyncpg://uas:change-me-local@postgres:5432/uas
UAS_REDIS_URL=redis://redis:6379/0
UAS_OBJECT_STORAGE_ENDPOINT=http://minio:9000
UAS_OBJECT_STORAGE_BUCKET=universal-ai-search-local
UAS_OBJECT_STORAGE_ACCESS_KEY=minio
UAS_OBJECT_STORAGE_SECRET_KEY=change-me-local

# Browser-visible configuration. Never put secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_API_URL=http://localhost:8000
