{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal AI Search",
  "version": "0.1.0",
  "identifier": "com.universalaisearch.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8000"
    },
    "windows": [
      {
        "label": "main",
        "title": "Universal AI Search",
        "width": 1000,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
